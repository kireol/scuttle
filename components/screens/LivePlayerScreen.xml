<?xml version="1.0" encoding="utf-8" ?>
<component name="LivePlayerScreen" extends="Group">
    <interface>
        <field id="closeMe" type="boolean" value="false" />
        <field id="wasShown" type="boolean" value="false" alwaysNotify="true" />
        <field id="server" type="assocarray" />
        <field id="cameras" type="array" />
        <field id="startIndex" type="integer" value="0" />
        <field id="snapPaths" type="array" />
        <field id="liveStreams" type="assocarray" />
        <field id="liveStreamsSub" type="assocarray" />
        <field id="portFirst" type="boolean" value="true" />
        <field id="cycleMode" type="boolean" value="false" />
        <field id="openInfo" type="boolean" value="false" />
        <!-- when set (cycle-all-servers), the tour hops servers at the end of
             each camera list; the player fetches each server's config itself -->
        <field id="tourServers" type="array" />
        <field id="stopPlayback" type="boolean" value="false" onChange="onStopPlayback" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/screens/LivePlayerScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/FrigateUrls.brs" />
    <script type="text/brightscript" uri="pkg:/source/AppSettings.brs" />
    <script type="text/brightscript" uri="pkg:/source/PrefStore.brs" />
    <children>
        <Video id="video" width="1920" height="1080" />
        <!-- shown in snapshot mode: hides the (gray) keepalive clip and any
             cascade attempts on the video plane, and turns letterbox bars
             around non-16:9 snapshots black. Shifted 2px — full occlusion
             makes the OS close the keepalive playback (screensaver returns) -->
        <Rectangle id="videoCover" translation="[2, 0]" width="1920" height="1080"
                   color="0x000000FF" visible="false" />
        <!-- last grid snapshot, dimmed, shown while the source cascade runs so
             the screen is never black during loading.
             loadWidth/loadHeight: cameras send 2560x1440+ JPEGs; decoding
             them at full size churns ~15MB textures every refresh and the OS
             eventually kills the channel (crash-to-home) — cap at the UI res -->
        <Poster id="placeholder" width="1920" height="1080" loadDisplayMode="scaleToFit"
                loadWidth="1920" loadHeight="1080" opacity="0.45" visible="false" />
        <!-- snapshot-mode fallback: full-screen stills, double-buffered -->
        <Poster id="snapA" width="1920" height="1080" loadDisplayMode="scaleToFit"
                loadWidth="1920" loadHeight="1080" visible="false" />
        <Poster id="snapB" width="1920" height="1080" loadDisplayMode="scaleToFit"
                loadWidth="1920" loadHeight="1080" visible="false" />
        <Label id="camName" translation="[60, 40]" color="0xFFFFFFFF"
               font="font:LargeBoldSystemFont" visible="false" />
        <!-- bottom-right, away from the OS screensaver clock (top-right);
             modeIcon: ● = snapshots, LIVE = video -->
        <Label id="modeIcon" translation="[1596, 1000]" width="100"
               color="0xFFFFFFFF" visible="false" />
        <Label id="clock" translation="[1360, 1000]" width="500" horizAlign="right"
               color="0xFFFFFFFF" visible="false" />
        <!-- translucent strip behind the bottom text so it always has contrast
             against video or snapshots; visibility follows the labels below.
             When only the clock is showing, a snug box replaces the full bar. -->
        <Rectangle id="bottomBar" translation="[0, 988]" width="1920" height="64"
                   color="0x30303080" visible="false" />
        <Rectangle id="clockBg" translation="[1584, 990]" width="296" height="52"
                   color="0x30303080" visible="false" />
        <!-- which stream (or snapshot mode) is currently being tried -->
        <Label id="loadingLabel" translation="[60, 1000]" color="0xC8D2D8FF" visible="false" />
        <!-- one-time pointer to the * info overlay, shown on first playback -->
        <Label id="hintLabel" translation="[0, 1000]" width="1920" horizAlign="center"
               color="0xE0E6EAFF" text="Press up for stream info" visible="false" />
        <Group id="errorPanel" visible="false">
            <Rectangle width="1920" height="1080" color="0x101418E0" />
            <Label id="errorTitle" text="Playback failed" translation="[660, 420]"
                   color="0xFF6B6BFF" font="font:LargeBoldSystemFont" />
            <Label id="errorDetail" translation="[400, 490]" width="1120" wrap="true" color="0xE0E6EAFF" />
            <Label id="errorHint" translation="[400, 600]" width="1120" wrap="true" color="0x8A959CFF"
                   text="All stream sources were tried without luck. Check that the camera is online and streaming H.264 or H.265. Press OK to retry, Back to exit." />
        </Group>
        <!-- * info overlay: stream details for the current camera -->
        <Group id="infoPanel" visible="false" translation="[60, 120]">
            <Rectangle id="infoBg" width="720" height="660" color="0x101418E0" />
            <Label id="infoText" translation="[28, 24]" width="664" wrap="true"
                   color="0xE0E6EAFF" lineSpacing="8" />
        </Group>
        <Group id="switcher" visible="false" translation="[0, 830]">
            <Rectangle width="1920" height="250" color="0x101418D0" />
            <MarkupGrid id="switchGrid" translation="[60, 20]" itemComponentName="SwitcherTile"
                        itemSize="[290, 181]" itemSpacing="[20, 0]" numColumns="6" numRows="1"
                        drawFocusFeedback="false" />
        </Group>
        <Timer id="nameTimer" duration="3" repeat="false" />
        <Timer id="fpsTimer" duration="5" repeat="true" />
        <Timer id="hintTimer" duration="5" repeat="false" />
        <Timer id="clockTimer" duration="10" repeat="true" />
        <!-- quiet background video retry while downgraded to snapshots -->
        <Timer id="retryTimer" duration="180" repeat="true" />
        <!-- weather refresh for the clock box -->
        <Timer id="weatherTimer" duration="900" repeat="true" />
        <!-- 1s cadence for master-playlist polling while MediaMTX warms up -->
        <Timer id="masterRetryTimer" duration="1" repeat="false" />
        <!-- 1s cadence for media-playlist polling while segments accumulate -->
        <Timer id="warmupTimer" duration="1" repeat="false" />
        <!-- mid-stream stall detector: fires while video should be advancing -->
        <Timer id="stallTimer" duration="10" repeat="true" />
        <!-- camera cycle dwell; duration set from settings at start -->
        <Timer id="cycleTimer" duration="10" repeat="true" />
    </children>
</component>
