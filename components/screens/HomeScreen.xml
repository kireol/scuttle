<?xml version="1.0" encoding="utf-8" ?>
<component name="HomeScreen" extends="Group">
    <interface>
        <field id="closeMe" type="boolean" value="false" />
        <field id="wasShown" type="boolean" value="false" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/screens/HomeScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/ServerStore.brs" />
    <script type="text/brightscript" uri="pkg:/source/AppSettings.brs" />
    <script type="text/brightscript" uri="pkg:/source/FrigateUrls.brs" />
    <children>
        <Group id="tabRow" translation="[60, 36]" />
        <Group id="menuRow" translation="[60, 104]" />
        <MarkupGrid id="grid" translation="[60, 170]" itemComponentName="CameraTile"
                    itemSize="[580, 362]" itemSpacing="[30, 30]" numColumns="3" numRows="2"
                    vertFocusAnimationStyle="floatingFocus" drawFocusFeedback="false" />
        <!-- scroll indicator, shown only when the grid has more rows than fit -->
        <Rectangle id="scrollTrack" translation="[1872, 170]" width="6" height="880"
                   color="0x2A343CFF" visible="false" />
        <Rectangle id="scrollThumb" translation="[1872, 170]" width="6" height="100"
                   color="0x2BB3C0FF" visible="false" />
        <Label id="status" translation="[60, 1010]" color="0x8A959CFF" text="" width="1800" />
        <!-- bottom-right: the Roku OS screensaver draws its own clock top-right
             when nothing is playing, and two stacked times looks broken -->
        <Label id="clock" translation="[1560, 1004]" width="300" horizAlign="right"
               color="0xE0E6EAFF" font="font:LargeBoldSystemFont" visible="false" />
        <Timer id="clockTimer" duration="10" repeat="true" />
        <Timer id="actTimer" duration="60" repeat="true" />
    </children>
</component>
