<?xml version="1.0" encoding="utf-8" ?>
<component name="ServerListScreen" extends="Group">
    <interface>
        <field id="closeMe" type="boolean" value="false" />
        <field id="wasShown" type="boolean" value="false" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/screens/ServerListScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/ServerStore.brs" />
    <script type="text/brightscript" uri="pkg:/source/AppSettings.brs" />
    <children>
        <Poster id="logo" uri="pkg:/images/logo.png" width="130" height="130"
                translation="[120, 45]" />
        <Label id="appTitle" text="Scuttle" translation="[275, 55]"
               color="0x2BB3C0FF" font="font:LargeBoldSystemFont" />
        <Label id="version" translation="[275, 55]" width="1520" horizAlign="right"
               color="0x8A959CFF" />
        <Label id="title" text="Settings" translation="[275, 112]"
               color="0xE0E6EAFF" font="font:LargeBoldSystemFont" />
        <Label id="hint" text="OK: select / change   Back: return"
               translation="[120, 180]" color="0x8A959CFF" />
        <LabelList id="list" translation="[120, 240]" itemSize="[1100, 64]"
                   numRows="10" vertFocusAnimationStyle="floatingFocus"
                   color="0xE0E6EAFF" focusedColor="0x10545CFF" />
    </children>
</component>
