<?xml version="1.0" encoding="utf-8" ?>
<component name="AppScene" extends="Scene">
    <interface>
        <field id="ready" type="boolean" value="false" onChange="onReady" />
        <field id="exitApp" type="boolean" value="false" />
        <field id="serversChanged" type="boolean" value="false" alwaysNotify="true" />
        <!-- server id HomeScreen should switch its tab to (set before popToRoot) -->
        <field id="goToServerId" type="string" value="" alwaysNotify="true" />
        <!-- ECP addserver payload, handed over from Main: the registry write
             must happen on the render thread, because writes flushed on the
             main thread are not reliably visible to render-thread readers,
             which then re-save their stale copy over the new data -->
        <field id="addServerInfo" type="assocarray" alwaysNotify="true" onChange="onAddServerInfo" />
        <function name="pushScreen" />
        <function name="popToRoot" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/AppScene.brs" />
    <script type="text/brightscript" uri="pkg:/source/ServerStore.brs" />
    <children>
        <Rectangle id="background" width="1920" height="1080" color="0x101418FF" />
        <Group id="screenHost" />
    </children>
</component>
