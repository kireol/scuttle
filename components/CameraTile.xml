<?xml version="1.0" encoding="utf-8" ?>
<component name="CameraTile" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContentChange" />
        <field id="focusPercent" type="float" onChange="onFocus" />
        <field id="itemHasFocus" type="boolean" onChange="onFocus" />
    </interface>
    <script type="text/brightscript" uri="pkg:/components/CameraTile.brs" />
    <children>
        <Rectangle id="frame" width="580" height="362" color="0x1A2228FF" />
        <!-- two posters, double-buffered: the new snapshot loads into the hidden
             one and is swapped in only once ready, so refreshes never flicker -->
        <Poster id="snapA" width="572" height="322" translation="[4, 4]" loadDisplayMode="scaleToFit" />
        <Poster id="snapB" width="572" height="322" translation="[4, 4]" loadDisplayMode="scaleToFit" visible="false" />
        <Label id="name" translation="[0, 330]" width="580" horizAlign="center"
               color="0xE0E6EAFF" font="font:MediumBoldSystemFont" />
        <Label id="badge" text="offline" translation="[480, 330]" color="0xFF6B6BFF" visible="false" />
        <!-- recent review activity (motion/object) on this camera -->
        <Label id="actBadge" text="● activity" translation="[12, 10]" color="0xFF6B6BFF"
               font="font:SmallBoldSystemFont" visible="false" />
        <!-- snapshot age warning when refreshes stop arriving -->
        <Label id="staleBadge" translation="[430, 10]" width="140" horizAlign="right"
               color="0xE0B040FF" font="font:SmallBoldSystemFont" visible="false" />
        <Rectangle id="focusRing" width="580" height="362" color="0x00000000" visible="false">
            <Rectangle id="frTop" width="580" height="4" color="0x2BB3C0FF" />
            <Rectangle id="frBottom" width="580" height="4" translation="[0, 358]" color="0x2BB3C0FF" />
            <Rectangle id="frLeft" width="4" height="362" color="0x2BB3C0FF" />
            <Rectangle id="frRight" width="4" height="362" translation="[576, 0]" color="0x2BB3C0FF" />
        </Rectangle>
    </children>
</component>
